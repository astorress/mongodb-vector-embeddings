ry" /></mxCell><mxCell id="vector-rag-28" parent="vector-rag-query" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;fontFamily=Verdana;" value="Claude API&lt;br&gt;(opcional)" vertex="1"><mxGeometry x="60" y="860" width="78" height="78" as="geometry" /></mxCell><mxCell id="vector-rag-29" parent="vector-rag-query" style="shape=mxgraph.veeam2.laptop;fillColor=#CCCCCC;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontFamily=Verdana;fontSize=12;" value="Compass / VS Code&lt;br&gt;(host, puerto 27027)" vertex="1"><mxGeometry x="1126" y="1020" width="100" height="60" as="geometry" /></mxCell><mxCell id="vector-rag-30" parent="vector-rag-query" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt;" vertex="1"><mxGeometry x="105" y="580" width="48" height="52" as="geometry" /></mxCell><mxCell id="vector-rag-31" parent="vector-rag-query" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(0, 127, 255);&quot;&gt;➋&lt;/font&gt;" vertex="1"><mxGeometry x="585" y="570" width="48" height="52" as="geometry" /></mxCell><mxCell id="vector-rag-32" parent="vector-rag-query" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(0, 127, 255);&quot;&gt;➏&lt;/font&gt;" vertex="1"><mxGeometry x="130" y="830" width="48" height="52" as="geometry" /></mxCell><mxCell id="vector-rag-33" parent="vector-rag-query" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(0, 127, 255);&quot;&gt;➐&lt;/font&gt;" vertex="1"><mxGeometry x="580" y="770" width="48" height="52" as="geometry" /></mxCell><mxCell id="vector-rag-34" parent="vector-rag-query" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(0, 127, 255);&quot;&gt;➑&lt;/font&gt;" vertex="1"><mxGeometry x="1220" y="990" width="48" height="52" as="geometry" /></mxCell><mxCell id="vector-rag-35" edge="1" parent="vector-rag-query" source="vector-rag-5" target="vector-rag-26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="vector-rag-36" edge="1" parent="vector-rag-query" source="vector-rag-26" target="vector-rag-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.25;exitY=0;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="537" y="560" /><mxPoint x="339" y="560" /></Array></mxGeometry></mxCell><mxCell id="vector-rag-37" edge="1" parent="vector-rag-query" source="vector-rag-26" target="vector-rag-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.6;entryX=0.25;entryY=1;exitPerimeter=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1132" y="647" /></Array></mxGeometry></mxCell><mxCell id="vector-rag-38" edge="1" parent="vector-rag-query" source="vector-rag-27" target="vector-rag-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;entryX=0.5;entryY=1;exitPerimeter=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1154" y="830" /></Array></mxGeometry></mxCell><mxCell id="vector-rag-39" edge="1" parent="vector-rag-query" source="vector-rag-7" target="vector-rag-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.65;entryX=0;entryY=0.65;exitPerimeter=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="vector-rag-40" edge="1" parent="vector-rag-query" source="vector-rag-26" target="vector-rag-28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=0;exitY=0.85;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200" y="664" /><mxPoint x="200" y="899" /></Array></mxGeometry></mxCell><mxCell id="vector-rag-41" edge="1" parent="vector-rag-query" source="vector-rag-29" target="vector-rag-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=0.5;exitY=0;entryX=0.75;entryY=1;exitPerimeter=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="vector-rag-42" parent="vector-rag-info" style="text;html=1;spacing=20;spacingTop=-30;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=12;fontFamily=Helvetica;fillColor=#7EA6E0;strokeColor=none;arcSize=4;glass=0;shadow=0;opacity=25;" value="&lt;h1 style=&quot;line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 18px;&quot;&gt;MongoDB Vector Embeddings (RAG)&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify; line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;p&gt;Proyecto para aprender búsqueda semántica con MongoDB. Son dos contenedores: uno con los &lt;b&gt;scripts&lt;/b&gt; en Python y otro con la &lt;b&gt;base de datos vectorial&lt;/b&gt;. La base es una sola y no hay réplicas ni sharding: dentro del contenedor MongoDB corre como replica set de un nodo solo porque el motor de búsqueda lee los cambios desde el oplog. Hay dos flujos: la &lt;b&gt;ingesta&lt;/b&gt; (verde, se corre una vez) y las &lt;b&gt;consultas&lt;/b&gt; (azul).&lt;/p&gt;&lt;p&gt;&lt;b&gt;Ingesta.&lt;/b&gt; El libro &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt; es el texto de Don Quijote de Project Gutenberg. &lt;b&gt;rag.ingest&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt; lo divide en sus 126 capítulos y cada capítulo en fragmentos de unos 1200 caracteres que se solapan un párrafo. El &lt;b&gt;modelo de embeddings&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt; convierte cada fragmento en un vector de 384 números que representa su significado; corre en CPU dentro del contenedor y se descarga una sola vez desde &lt;b&gt;Hugging Face&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt;. Los fragmentos se guardan en &lt;b&gt;mongod&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt; con su texto, volumen, capítulo y vector en el mismo documento; la carga es idempotente y continúa donde quedó si se interrumpe. Al final se crean dos índices de búsqueda, uno vectorial y otro de texto completo en español, que construye &lt;b&gt;mongot&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt;: lee los documentos de mongod por change streams y los mantiene al día solo.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Consultas.&lt;/b&gt; El desarrollador &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt; ejecuta &lt;b&gt;rag.search&lt;/b&gt; o &lt;b&gt;rag.ask&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➋&lt;/font&gt;. La pregunta pasa por el mismo &lt;b&gt;modelo&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➌&lt;/font&gt; para obtener su vector, y el script envía a &lt;b&gt;mongod&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➍&lt;/font&gt; una agregación: búsqueda semántica, de texto completo o híbrida, con filtros opcionales por volumen o capítulo. Los scripts nunca hablan con mongot: mongod le reenvía la búsqueda por gRPC, &lt;b&gt;mongot&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➎&lt;/font&gt; recorre sus índices (un grafo HNSW para los vectores, BM25 para el texto) y le devuelve los fragmentos más cercanos con su puntaje. En la híbrida, mongod fusiona ambos rankings por posición dentro del servidor.&lt;/p&gt;&lt;p&gt;En &lt;b&gt;rag.ask&lt;/b&gt; los fragmentos recuperados se numeran y se arman en un prompt con la pregunta. Si hay API key, se envía a &lt;b&gt;Claude&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➏&lt;/font&gt;, que responde solo con esos fragmentos y cita de cuál sale cada afirmación; sin key, el script muestra el prompt y termina ahí.&lt;/p&gt;&lt;p&gt;&lt;b&gt;mongosh&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➐&lt;/font&gt; ejecuta los mismos tipos de consulta desde la shell (explorar la colección, ver los índices, buscar pasajes parecidos a uno guardado, texto completo con resaltado). Desde la máquina anfitriona, &lt;b&gt;Compass&lt;/b&gt; o VS Code &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➑&lt;/font&gt; se conectan directo a mongod por el puerto publicado.&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="2010" y="80" width="720" height="520" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>
