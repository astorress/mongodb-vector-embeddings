{
  "name": "mongodb-vector-embeddings",
  "dockerComposeFile": ".docker/docker-compose.yml",
  "service": "vector_embeddings_rag",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "davidanson.vscode-markdownlint",
        "eamodio.gitlens",
        "eeyore.yapf",
        "irongeek.vscode-env",
        "mongodb.mongodb-vscode",
        "ms-azuretools.vscode-docker",
        "ms-python.isort",
        "ms-python.pylint",
        "ms-python.python",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "pylint.interpreter": ["/usr/local/bin/python"],
        "yapf.interpreter": ["/usr/local/bin/python"],
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "eeyore.yapf",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  },
  "initializeCommand": "chmod +x .docker/initialize.sh && .docker/initialize.sh",
  "postCreateCommand": "chmod +x .docker/entrypoint.sh && .docker/entrypoint.sh"
}
